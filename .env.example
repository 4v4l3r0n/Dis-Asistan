# ==============================================================================
# AI Chatbot Projesi — Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayarak '.env' adında yeni bir dosya oluşturun:
#   cp .env.example .env (veya Windows'ta: copy .env.example .env)
# ==============================================================================

# PostgreSQL Ayarları
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_secure_pass_2025

# n8n Güvenlik Anahtarı (en az 32 karakterlik rastgele bir metin oluşturun)
N8N_ENCRYPTION_KEY=degistiriniz_en_az_32_karakter_olmalidir_12345

# Google Gemini API Anahtarı (https://aistudio.google.com adresinden temin edilir)
GEMINI_API_KEY=your_gemini_api_key_here
